# Compartilhado entre produção e dev — configure antes de subir.

# PostgreSQL
POSTGRES_PASSWORD=app

# Backend
JWT_SECRET=troque-esta-chave-em-producao
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
# Define Secure no cookie de sessão (defina true quando servir via HTTPS)
COOKIE_SECURE=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=acordaos.informe@gmail.com
SMTP_FROM_NAME=Gab. Des. Helio Bastida Lopes
SMTP_REPLY_TO=gdhbl@trt12.jus.br

# Intervalo opcional entre e-mails (segundos)
EMAIL_DELAY_MIN=0
EMAIL_DELAY_MAX=0

# Frontend (SSR)
# URL interna da API usada pelo servidor Nitro (dentro da rede Docker)
API_INTERNAL_URL=http://backend:3001
# Alvo do proxy /api do Nitro para o backend (usa no build)
API_PROXY_TARGET=http://backend:3001

# Seed do usuário administrador (pnpm seed)
SEED_ADMIN_EMAIL=admin@trt12.jus.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NOME=Administrador
